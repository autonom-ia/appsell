# Obrigatórios para o BFF OAuth local. Use uma instância isolada e um prefixo
# exclusivo por ambiente/execução; nunca reutilize um Redis ou namespace existente.
APPSELL_REDIS_URL=redis://127.0.0.1:6380/0
APPSELL_REDIS_PREFIX=appsell:local:developer-unique
# Gere localmente: openssl rand -base64 32
APPSELL_SESSION_HMAC_KEY_B64=REPLACE_WITH_CANONICAL_BASE64_32_BYTE_KEY
# Provider local de envelope encryption, permitido somente em Local/CI.
# Gere OUTRA chave com `openssl rand -base64 32`; nunca reutilize a chave HMAC.
# Exatamente uma entrada deve ter `active: true`; antigas ficam read-only durante rotação.
APPSELL_VAULT_LOCAL_KEYRING_B64_JSON=[{"id":"local-v1","key":"REPLACE_WITH_OTHER_CANONICAL_BASE64_32_BYTE_KEY","active":true}]
