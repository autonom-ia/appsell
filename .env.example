# Obrigatórios para o BFF OAuth local. Use uma instância isolada e um prefixo
# exclusivo por ambiente/execução; nunca reutilize um Redis ou namespace existente.
NODE_ENV=development
APP_ENV=local
APPSELL_REDIS_URL=redis://127.0.0.1:6380/0
APPSELL_REDIS_PREFIX=appsell:local:developer-unique
# Gere localmente: openssl rand -base64 32
APPSELL_SESSION_HMAC_KEY_B64=REPLACE_WITH_CANONICAL_BASE64_32_BYTE_KEY
# Provider local de envelope encryption, permitido somente em Local/CI.
# Selecione explicitamente `local` ou `openbao-transit`; nenhum está certificado
# para produção neste slice.
APPSELL_VAULT_PROVIDER=local
# Gere OUTRA chave com `openssl rand -base64 32`; nunca reutilize a chave HMAC.
# Exatamente uma entrada deve ter `active: true`; antigas ficam read-only durante rotação.
APPSELL_VAULT_LOCAL_KEYRING_B64_JSON=[{"id":"local-v1","key":"REPLACE_WITH_OTHER_CANONICAL_BASE64_32_BYTE_KEY","active":true}]
# OpenBao Transit descartável para Local/CI. O token runtime deve ter apenas
# update nos endpoints encrypt/decrypt da chave já criada; nunca use root aqui.
APPSELL_OPENBAO_ADDR=http://127.0.0.1:58200
APPSELL_OPENBAO_TRANSIT_MOUNT=appsell-transit
APPSELL_OPENBAO_TRANSIT_KEY=appsell-oauth-vault
APPSELL_OPENBAO_TOKEN=REPLACE_WITH_EPHEMERAL_RESTRICTED_TOKEN
APPSELL_OPENBAO_HTTP_TIMEOUT_MS=1000
APPSELL_OPENBAO_PORT=58200

# AWS KMS token vault (APPSELL_VAULT_PROVIDER=aws-kms). Certified for production.
# APPSELL_KMS_KEY_ID = KMS key id, alias, or full ARN used for Encrypt/Decrypt.
# APPSELL_KMS_KEY_NAME = logical kid persisted in the envelope ([A-Za-z0-9._-], <=64).
APPSELL_KMS_KEY_ID=REPLACE_WITH_KMS_KEY_ARN
APPSELL_KMS_KEY_NAME=appsell-token-vault
APPSELL_KMS_REGION=us-east-1
APPSELL_KMS_HTTP_TIMEOUT_MS=2000
# APPSELL_KMS_ENDPOINT= optional override, LOOPBACK-ONLY (LocalStack/tests). Prod uses the SDK regional endpoint.
# Gere uma terceira chave independente: openssl rand -base64 32
APPSELL_CSRF_HMAC_KEY_B64=REPLACE_WITH_THIRD_CANONICAL_BASE64_32_BYTE_KEY
APPSELL_PUBLIC_ORIGIN=http://localhost:3000
# `local` mantém o provedor demonstrativo; `identity` usa a Foundation real.
# Produção aceita somente `identity` e ainda exige um provider de vault não local.
APPSELL_OAUTH_MODE=local
# Origem pública exata usada exclusivamente pelos PUTs pré-assinados de assets.
APPSELL_STORAGE_PUBLIC_ORIGIN=http://127.0.0.1:58333
# Ponte privada BFF→API. Gere uma quarta chave e uma credencial separadas.
APPSELL_DOMAIN_API_URL=http://127.0.0.1:58000
# Produção exige HTTPS em APPSELL_DOMAIN_API_URL, exceto para hosts internos
# nomeados aqui (nomes de serviço Docker single-label, sem ponto). Fail-closed:
# sem esta var, http em produção continua rejeitado (insecure_domain_api_url).
# APPSELL_DOMAIN_API_TRUSTED_INTERNAL_HOSTS=sell-autonomia_api
APPSELL_INTERNAL_ISSUER=appsell-bff-local
APPSELL_INTERNAL_AUDIENCE=appsell-api-local
# Adapter OAuth/OIDC server-only ligado às rotas quando APPSELL_OAUTH_MODE=identity.
# Client lógico e audience dos tokens Foundation são configuráveis (default abaixo)
# e devem coincidir com o que o provedor emite. Padrão aceito: ^[a-z0-9][a-z0-9._-]{0,63}$.
APPSELL_IDENTITY_LOGICAL_OAUTH_CLIENT_ID=appsell-web
APPSELL_IDENTITY_EXPECTED_AUDIENCE=appsell-web
# Modos de compatibilidade (Opção B). Default = comportamento legado intacto.
# APPSELL_IDENTITY_REFRESH_MODE: logical-handle (default) | provider-refresh
#   provider-refresh aceita refresh token opaco do provedor, sem rotação obrigatória.
# APPSELL_IDENTITY_NONCE_MODE: required (default) | disabled
#   disabled não envia nonce e rejeita ID token com nonce inesperado.
APPSELL_IDENTITY_REFRESH_MODE=logical-handle
APPSELL_IDENTITY_NONCE_MODE=required
APPSELL_IDENTITY_ISSUER=https://REPLACE_WITH_IDENTITY_ISSUER
APPSELL_IDENTITY_AUTHORIZATION_URL=https://REPLACE_WITH_IDENTITY_AUTH_ORIGIN/login
APPSELL_IDENTITY_TOKEN_URL=https://REPLACE_WITH_IDENTITY_API_ORIGIN/oauth/token
APPSELL_IDENTITY_JWKS_URL=https://REPLACE_WITH_IDENTITY_ISSUER/.well-known/jwks.json
APPSELL_IDENTITY_ALLOWED_ORIGINS=https://REPLACE_WITH_IDENTITY_AUTH_ORIGIN,https://REPLACE_WITH_IDENTITY_API_ORIGIN,https://REPLACE_WITH_IDENTITY_ISSUER
APPSELL_IDENTITY_REDIRECT_URI=http://localhost:3000/auth/callback
# Opcionais, limitados internamente a 100..10000 ms e 1024..65536 bytes.
APPSELL_IDENTITY_HTTP_TIMEOUT_MS=5000
APPSELL_IDENTITY_MAX_RESPONSE_BYTES=32768
# Limite conservador enquanto a Foundation não retorna refresh_expires_in.
# Deve ser menor ou igual ao TTL do client appsell-web na Foundation.
APPSELL_IDENTITY_REFRESH_HANDLE_TTL_SECONDS=86400
APPSELL_LOCAL_IDENTITY_EMAIL=creator@example.test
APPSELL_INTERNAL_HMAC_KEYRING_B64_JSON=[{"id":"local-v1","key":"REPLACE_WITH_FOURTH_CANONICAL_BASE64_32_BYTE_KEY","active":true}]
APPSELL_SERVICE_CREDENTIAL_B64=REPLACE_WITH_FIFTH_CANONICAL_BASE64_32_BYTE_KEY
# Diretório absoluto, privado e fora do web root. Obrigatório em produção.
APPSELL_PRIVATE_LEARNING_ASSET_ROOT=/absolute/private/path/appsell/learning-assets

# PostgreSQL/API local. Use senhas aleatórias e um banco exclusivo do AppSell.
APPSELL_POSTGRES_PORT=55432
APPSELL_API_PORT=58000
APPSELL_POSTGRES_SUPERUSER_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_VALUE
APPSELL_MIGRATOR_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_LOCAL_VALUE
APPSELL_RUNTIME_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_LOCAL_VALUE
# Gere localmente: openssl rand -hex 32
APPSELL_CONTEXT_SIGNING_KEY_HEX=REPLACE_WITH_CANONICAL_HEX_32_BYTE_KEY
# Mesmo material da chave de contexto acima, codificado em base64 para o runtime API.
APPSELL_API_CONTEXT_HMAC_KEY_B64=REPLACE_WITH_CONTEXT_KEY_AS_CANONICAL_BASE64
APPSELL_API_WEBHOOK_LOCAL_KEYRING_B64_JSON=[]
APPSELL_API_WEBHOOK_FORBIDDEN_KEY_SHA256_JSON=[]
APPSELL_API_MALWARE_SCANNER_PROVIDER=deterministic
# Storage privado permanece desativado por padrão; PDFs legados continuam no
# diretório privado local. Para AWS S3 real, configure buckets físicos privados
# e distintos para quarantine e ready, com versionamento/CORS já provisionados,
# além de um prefixo exclusivo e estável.
# O boto3 lê credenciais do ambiente (`AWS_ACCESS_KEY_ID`,
# `AWS_SECRET_ACCESS_KEY`, `AWS_SESSION_TOKEN`) ou da IAM role do runtime.
# A API audita, mas não cria nem altera os buckets AWS. Nunca versione valores
# reais. Endpoints ficam vazios no AWS S3 nativo.
APPSELL_API_STORAGE_PROVIDER=disabled
# Para ativar: APPSELL_API_STORAGE_PROVIDER=s3
# APPSELL_API_STORAGE_QUARANTINE_BUCKET=REPLACE_WITH_PRIVATE_QUARANTINE_BUCKET
# APPSELL_API_STORAGE_READY_BUCKET=REPLACE_WITH_PRIVATE_READY_BUCKET
# APPSELL_API_STORAGE_REGION=us-east-1
# APPSELL_API_STORAGE_PREFIX=appsell/local
# APPSELL_API_STORAGE_ALLOWED_ORIGIN=http://localhost:3000
# AWS_ACCESS_KEY_ID=REPLACE_WITH_EPHEMERAL_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=REPLACE_WITH_EPHEMERAL_SECRET_KEY
# AWS_SESSION_TOKEN=REPLACE_WITH_EPHEMERAL_SESSION_TOKEN
# Ative somente após migration 0013, sandbox/worker media-v1 saudáveis e workers antigos drenados.
APPSELL_API_VIDEO_UPLOAD_ENABLED=false
# Staging/produção: use clamav com clamd colocalizado por socket Unix.
APPSELL_API_MALWARE_SCANNER_SOCKET=/run/appsell-clamav/clamd.sock
# Gere outra chave independente: openssl rand -hex 32
APPSELL_BOOTSTRAP_ATTESTATION_KEY_HEX=REPLACE_WITH_OTHER_CANONICAL_HEX_32_BYTE_KEY
APPSELL_BOOTSTRAP_ENABLED=false
APPSELL_BOOTSTRAP_EXPECTED_ISSUER=https://REPLACE_WITH_IDENTITY_ISSUER
APPSELL_BOOTSTRAP_EXPECTED_AUDIENCE=REPLACE_WITH_APPSELL_AUDIENCE
APPSELL_BOOTSTRAP_EXPECTED_CLIENT_ID=REPLACE_WITH_APPSELL_CLIENT_ID
APPSELL_API_DATABASE_URL=postgresql+asyncpg://appsell_runtime:REPLACE_WITH_RUNTIME_PASSWORD@127.0.0.1:55432/appsell
APPSELL_API_DATABASE_APPLICATION_NAME=appsell_api
APPSELL_MIGRATOR_DATABASE_URL=postgresql+psycopg://appsell_migrator:REPLACE_WITH_MIGRATOR_PASSWORD@127.0.0.1:55432/appsell

# --- Integração Financial (pipeline Hotmart, P1) ---
# Base do Financial cutover (Stripe Connect é dono do pagamento; Appsell só consome).
FINANCIAL_API_URL=https://financial.api-autonomia.com
# Chave interna do stack para o proxy de checkout de registro (x-api-key). NUNCA commitar valor.
FINANCIAL_INTERNAL_API_KEY=REPLACE_WITH_FINANCIAL_INTERNAL_API_KEY
