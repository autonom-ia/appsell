{
  "name": "@autonom-ia/appsell-oauth-bff-spike",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --config vitest.fast.config.ts",
    "test:e2e": "node scripts/with-isolated-redis.mjs pnpm exec playwright test",
    "test:e2e:identity-real": "node scripts/with-isolated-redis.mjs node scripts/run-real-identity-cross-repo.mjs",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1091.0",
    "@noble/hashes": "^2.2.0",
    "@stripe/connect-js": "^3.4.6",
    "@stripe/react-connect-js": "^3.4.4",
    "@stripe/stripe-js": "^7.9.0",
    "gsap": "^3.15.0",
    "ioredis": "5.10.0",
    "jose": "6.2.3",
    "lenis": "^1.3.26",
    "next": "16.2.11",
    "nodemailer": "^9.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "22.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.11",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "pnpm": {
    "overrides": {
      "browserslist": ">=4.28.7"
    }
  }
}
