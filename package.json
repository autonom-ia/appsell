    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.10",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.16",
