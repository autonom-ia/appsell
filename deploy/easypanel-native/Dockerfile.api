FROM ghcr.io/astral-sh/uv:0.11.13@sha256:841c8e6fe30a8b07b4478d12d0c608cba6de66102d29d65d1cc423af86051563 AS uv

FROM python:3.12.11-slim@sha256:47ae396f09c1303b8653019811a8498470603d7ffefc29cb07c88f1f8cb3d19f AS builder
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /opt/app/apps/api
COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

FROM python:3.12.11-slim@sha256:47ae396f09c1303b8653019811a8498470603d7ffefc29cb07c88f1f8cb3d19f AS runtime

ARG GIT_SHA
LABEL org.opencontainers.image.source="https://github.com/autonom-ia/appsell" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      com.autonomia.project="sell-autonomia" \
      com.autonomia.runtime="api-native"
ENV PATH="/opt/app/apps/api/.venv/bin:${PATH}" \
    PYTHONPATH="/opt/app/apps/api/src" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
# poppler-utils e ffmpeg existem aqui porque o asset-worker roda ESTA imagem e
# invoca pdftoppm e ffmpeg como processos. Sem eles o worker pegava o trabalho,
# falhava com PdfDerivativeUnavailable, engolia o erro num warning e repetia ate
# o lease expirar — para sempre. Material de aula ficou impossivel de 22/08 a
# 26/08/2026 por causa disto, sem nenhum erro visivel.
RUN groupadd --system --gid 10001 appsell \
    && useradd --system --uid 10001 --gid 10001 --home /opt/app appsell \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates ffmpeg fonts-dejavu-core poppler-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/app
COPY --from=builder /opt/app/apps/api/.venv apps/api/.venv
COPY apps/api/src apps/api/src
COPY output/pdf/codex/01-o-que-e-codex/pages output/pdf/codex/01-o-que-e-codex/pages
COPY output/pdf/codex/02-contexto-repo-objetivo/pages output/pdf/codex/02-contexto-repo-objetivo/pages
COPY output/pdf/codex/03-implementar-com-seguranca/pages output/pdf/codex/03-implementar-com-seguranca/pages
COPY output/pdf/codex/04-revisar-testes-pr/pages output/pdf/codex/04-revisar-testes-pr/pages
COPY output/pdf/codex/05-deploy-e-rollback/pages output/pdf/codex/05-deploy-e-rollback/pages
RUN test -n "${GIT_SHA}" \
    && test "${GIT_SHA}" != "undefined" \
    && test "$(find output/pdf/codex -type f -name '*.png' | wc -l | tr -d ' ')" = "5" \
    && test -z "$(find output/pdf/codex -type f ! -name '*.png' -print -quit)" \
    && chown -R appsell:appsell /opt/app
USER appsell
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=2)"]
CMD ["uvicorn", "appsell_api.main:app", "--app-dir", "apps/api/src", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
