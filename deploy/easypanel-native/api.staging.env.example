APPSELL_API_ENVIRONMENT=ci
APPSELL_API_DATABASE_URL=postgresql+asyncpg://appsell_native_90_runtime:<exclusive-runtime-password>@sell-autonomia_postgres-native-90:5432/appsell_native_90
APPSELL_API_DATABASE_APPLICATION_NAME=appsell_native_90_api
APPSELL_API_INTERNAL_ISSUER=appsell-bff-native-90
APPSELL_API_INTERNAL_AUDIENCE=appsell-api-native-90
APPSELL_API_IDENTITY_ISSUER=https://identity.native.local
APPSELL_API_INTERNAL_HMAC_KEYRING_B64_JSON=<same-internal-keyring-as-web>
APPSELL_API_CONTEXT_HMAC_KEY_B64=<base64-of-bootstrap-context-signing-key-hex>
APPSELL_API_SERVICE_CREDENTIAL_B64=<same-service-credential-as-web>
APPSELL_API_WEBHOOK_LOCAL_KEYRING_B64_JSON=[]
APPSELL_API_WEBHOOK_FORBIDDEN_KEY_SHA256_JSON=[]
APPSELL_API_MALWARE_SCANNER_PROVIDER=disabled
APPSELL_API_VIDEO_UPLOAD_ENABLED=false
APPSELL_API_STORAGE_PROVIDER=disabled
# Só na rede isolada do storage (#461): true aceita http no endpoint interno,
# e só para um nome de serviço de um rótulo, sem ponto nem "_" (ex.:
# http://appsell-storage:9000). O endpoint público e a origem continuam https.
APPSELL_API_STORAGE_INTERNAL_HTTP_ALLOWED=false
APPSELL_API_PDF_SANDBOX_URL=
APPSELL_API_PDF_SANDBOX_SOCKET=
APPSELL_API_PRIVATE_LEARNING_ASSET_ROOT=/opt/app/output/pdf/codex
# A API e quem busca o video referenciado dentro do PDF. Sem esta lista ela nao
# busca nada — e o aluno recebe 503 em todo video.
APPSELL_PDF_VIDEO_ALLOWED_ORIGINS=https://REPLACE_WITH_PRIVATE_VIDEO_ORIGIN
