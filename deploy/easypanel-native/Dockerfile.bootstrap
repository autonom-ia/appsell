FROM ghcr.io/astral-sh/uv:0.11.13@sha256:841c8e6fe30a8b07b4478d12d0c608cba6de66102d29d65d1cc423af86051563 AS uv

FROM python:3.12.11-slim@sha256:47ae396f09c1303b8653019811a8498470603d7ffefc29cb07c88f1f8cb3d19f

ARG GIT_SHA
LABEL org.opencontainers.image.source="https://github.com/autonom-ia/appsell" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      com.autonomia.project="sell-autonomia" \
      com.autonomia.runtime="bootstrap-native"
ENV PATH="/opt/app/apps/api/.venv/bin:${PATH}" \
    PYTHONPATH="/opt/app/apps/api/src" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
COPY --from=uv /uv /usr/local/bin/uv
RUN groupadd --system --gid 10001 appsell \
    && useradd --system --uid 10001 --gid 10001 --home /opt/app appsell \
    && apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates postgresql-client \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/app/apps/api
COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
WORKDIR /opt/app
COPY apps/api/src apps/api/src
COPY apps/api/migrations apps/api/migrations
COPY apps/api/alembic.ini apps/api/alembic.ini
COPY demo demo
COPY output/pdf output/pdf
COPY deploy/easypanel-native/bootstrap-native-demo.sh deploy/easypanel-native/bootstrap-native-demo.sh
RUN test -n "${GIT_SHA}" \
    && test "${GIT_SHA}" != "undefined" \
    && chmod 0555 deploy/easypanel-native/bootstrap-native-demo.sh \
    && chown -R appsell:appsell /opt/app
USER appsell
# EasyPanel App Services restart completed processes by default. Keep this
# temporary container inert; the reviewed bootstrap is executed exactly once
# through the EasyPanel console and the service is destroyed immediately after.
CMD ["sleep", "infinity"]
