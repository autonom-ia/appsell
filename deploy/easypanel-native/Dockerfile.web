FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS builder

ARG GIT_SHA
ENV COREPACK_HOME=/opt/corepack \
    PNPM_HOME=/opt/pnpm \
    PATH=/opt/pnpm:${PATH} \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN corepack pnpm install --frozen-lockfile --prod=false
COPY . .
RUN test -n "${GIT_SHA}" \
    && test "${GIT_SHA}" != "undefined" \
    && NODE_ENV=production corepack pnpm build \
    && mkdir -p /tmp/web-assets/output/pdf/codex \
    && cp output/pdf/codex/codex-em-3-passos.mp4 /tmp/web-assets/output/pdf/codex/ \
    && cp output/pdf/codex/05-deploy-e-rollback.pdf /tmp/web-assets/output/pdf/codex/ \
    && test "$(find /tmp/web-assets -type f -name '*.pdf' | wc -l | tr -d ' ')" = "1" \
    && test ! -e /tmp/web-assets/output/pdf/codex/01-o-que-e-codex.pdf \
    && test ! -e /tmp/web-assets/output/pdf/codex/02-contexto-repo-objetivo.pdf \
    && test ! -e /tmp/web-assets/output/pdf/codex/03-implementar-com-seguranca.pdf \
    && test ! -e /tmp/web-assets/output/pdf/codex/04-revisar-testes-pr.pdf

FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS runtime

ARG GIT_SHA
LABEL org.opencontainers.image.source="https://github.com/autonom-ia/appsell" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      com.autonomia.project="sell-autonomia" \
      com.autonomia.runtime="web-native"
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    NEXT_TELEMETRY_DISABLED=1
RUN groupadd --system --gid 10001 appsell \
    && useradd --system --uid 10001 --gid 10001 --home /app appsell
WORKDIR /app
COPY --from=builder --chown=appsell:appsell /app/.next/standalone ./
COPY --from=builder --chown=appsell:appsell /app/.next/static ./.next/static
COPY --from=builder --chown=appsell:appsell /tmp/web-assets/output ./output
USER appsell
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "server.js"]
